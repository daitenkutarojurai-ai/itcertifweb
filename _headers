# Cloudflare Pages — security headers
#
# ⚠️ INERT IN PRODUCTION: certquests.com is served by GitHub Pages, which does
# NOT read this file. The headers below (CSP/HSTS/X-Frame-Options) and the
# immutable cache rules are therefore NOT applied to live responses (GitHub
# Pages forces cache-control: max-age=600). Kept for a possible future
# Cloudflare Pages migration. Do not assume these protections are live.
#
# Applied to every response. See:
#   https://developers.cloudflare.com/pages/configuration/headers/

/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://esm.sh https://www.googletagmanager.com https://*.google-analytics.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https: https://i.scdn.co; connect-src 'self' https://zhxnteqtiyqnyidfkivj.supabase.co wss://zhxnteqtiyqnyidfkivj.supabase.co https://api.open-meteo.com https://www.google-analytics.com; frame-src 'self' https://open.spotify.com; manifest-src 'self'; worker-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests

# Hashed assets (versioned via ?v=N) can be cached aggressively.
# The query string changes on every deploy so this is safe.
/src/*
  Cache-Control: public, max-age=31536000, immutable

/data/*
  Cache-Control: public, max-age=3600

# Service worker must always be revalidated.
/sw.js
  Cache-Control: public, max-age=0, must-revalidate
