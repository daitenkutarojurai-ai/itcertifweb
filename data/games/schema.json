{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://itcertif.com/data/games/schema.json",
  "title": "Learning-path game-mode payloads",
  "type": "object",
  "required": ["mode", "title", "data"],
  "properties": {
    "mode": {
      "type": "string",
      "enum": [
        "match-pair",
        "lightning-round",
        "break-architecture",
        "acronym-decoder",
        "true-false-blitz",
        "scenario-builder",
        "boss-fight"
      ]
    },
    "title": { "type": "string", "minLength": 1 },
    "explanation": { "type": "string" },
    "data": { "type": "object" }
  },
  "allOf": [
    {
      "if": { "properties": { "mode": { "const": "match-pair" } } },
      "then": { "properties": { "data": { "$ref": "#/$defs/MatchPair" } } }
    },
    {
      "if": { "properties": { "mode": { "const": "lightning-round" } } },
      "then": { "properties": { "data": { "$ref": "#/$defs/LightningRound" } } }
    },
    {
      "if": { "properties": { "mode": { "const": "break-architecture" } } },
      "then": { "properties": { "data": { "$ref": "#/$defs/BreakArchitecture" } } }
    },
    {
      "if": { "properties": { "mode": { "const": "acronym-decoder" } } },
      "then": { "properties": { "data": { "$ref": "#/$defs/AcronymDecoder" } } }
    },
    {
      "if": { "properties": { "mode": { "const": "true-false-blitz" } } },
      "then": { "properties": { "data": { "$ref": "#/$defs/TrueFalseBlitz" } } }
    },
    {
      "if": { "properties": { "mode": { "const": "scenario-builder" } } },
      "then": { "properties": { "data": { "$ref": "#/$defs/ScenarioBuilder" } } }
    },
    {
      "if": { "properties": { "mode": { "const": "boss-fight" } } },
      "then": { "properties": { "data": { "$ref": "#/$defs/BossFight" } } }
    }
  ],
  "$defs": {
    "MatchPair": {
      "type": "object",
      "required": ["pairs"],
      "properties": {
        "pairs": {
          "type": "array",
          "minItems": 3,
          "maxItems": 8,
          "items": {
            "type": "object",
            "required": ["left", "right"],
            "properties": {
              "left": { "type": "string" },
              "right": { "type": "string" }
            }
          }
        }
      }
    },
    "LightningRound": {
      "type": "object",
      "required": ["questions"],
      "properties": {
        "secondsPerQuestion": { "type": "integer", "minimum": 3, "maximum": 15, "default": 7 },
        "livesAllowed": { "type": "integer", "minimum": 1, "maximum": 5, "default": 3 },
        "questions": {
          "type": "array",
          "minItems": 5,
          "items": {
            "type": "object",
            "required": ["q", "choices", "correctIndex"],
            "properties": {
              "q": { "type": "string" },
              "choices": { "type": "array", "minItems": 2, "maxItems": 4, "items": { "type": "string" } },
              "correctIndex": { "type": "integer", "minimum": 0 },
              "explanation": { "type": "string" }
            }
          }
        }
      }
    },
    "BreakArchitecture": {
      "type": "object",
      "required": ["diagram", "maskedToken", "choices", "correctIndex"],
      "properties": {
        "diagramFormat": { "type": "string", "enum": ["ascii", "svg"], "default": "ascii" },
        "diagram": { "type": "string", "description": "ASCII art or inline SVG; the maskedToken is replaced with a blank placeholder at render time." },
        "maskedToken": { "type": "string", "description": "Token in the diagram to mask. Renderer replaces it with `▢▢▢`." },
        "choices": { "type": "array", "minItems": 2, "maxItems": 4, "items": { "type": "string" } },
        "correctIndex": { "type": "integer", "minimum": 0 },
        "explanation": { "type": "string" }
      }
    },
    "AcronymDecoder": {
      "type": "object",
      "required": ["acronym", "correct", "distractors"],
      "properties": {
        "acronym": { "type": "string" },
        "correct": {
          "type": "object",
          "required": ["fullName", "useCase"],
          "properties": {
            "fullName": { "type": "string" },
            "useCase": { "type": "string" }
          }
        },
        "distractors": {
          "type": "array",
          "minItems": 2,
          "maxItems": 4,
          "items": {
            "type": "object",
            "required": ["fullName", "useCase"],
            "properties": {
              "fullName": { "type": "string" },
              "useCase": { "type": "string" }
            }
          }
        }
      }
    },
    "TrueFalseBlitz": {
      "type": "object",
      "required": ["statements"],
      "properties": {
        "secondsPerStatement": { "type": "integer", "minimum": 2, "maximum": 10, "default": 4 },
        "statements": {
          "type": "array",
          "minItems": 5,
          "items": {
            "type": "object",
            "required": ["text", "isTrue"],
            "properties": {
              "text": { "type": "string" },
              "isTrue": { "type": "boolean" },
              "explanation": { "type": "string" }
            }
          }
        }
      }
    },
    "ScenarioBuilder": {
      "type": "object",
      "required": ["scenario", "pool", "correctOrder"],
      "properties": {
        "scenario": { "type": "string" },
        "pool": { "type": "array", "minItems": 3, "items": { "type": "string" }, "description": "All selectable services. correctOrder MUST be a subset, in the right order." },
        "correctOrder": { "type": "array", "minItems": 2, "items": { "type": "string" } },
        "explanation": { "type": "string" }
      }
    },
    "BossFight": {
      "type": "object",
      "required": ["questionIds"],
      "properties": {
        "questionIds": { "type": "array", "minItems": 5, "maxItems": 20, "items": { "type": "string" }, "description": "References question IDs from the cert's free/*.json pack." },
        "timeLimitMinutes": { "type": "integer", "minimum": 1, "maximum": 30 },
        "passingScore": { "type": "integer", "minimum": 0, "maximum": 100, "default": 70 },
        "difficultyCurve": { "type": "string", "enum": ["flat", "rising", "easyhardeasy"], "default": "rising" }
      }
    }
  }
}
